{
  "manifest_version": 3,
  "name": "Shopify Skins",
  "description": "Slack-style colour themes for Shopify admin, plus optional theme preview and rename.",
  "version": "0.3.5",
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.myshopify.com/*",
    "https://admin.shopify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Shopify Skins",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon_16.png",
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://admin.shopify.com/*"
      ],
      "js": [
        "theme_storage.js",
        "colour_scheme.js",
        "settings.js",
        "utils.js",
        "content.js",
        "preview.js",
        "rename.js",
        "store_switch_ui.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://online-store-web.shopifyapps.com/*"
      ],
      "js": [
        "theme_storage.js",
        "settings.js",
        "utils.js",
        "preview.js",
        "rename.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
