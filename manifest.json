{
  "manifest_version": 3,
  "name": "Shopify Skins",
  "description": "Apply custom Slack-style colour themes to the Shopify admin.",
  "version": "0.3.0",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.myshopify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Shopify Skins",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://admin.shopify.com/*"
      ],
      "js": [
        "theme_storage.js",
        "colour_scheme.js",
        "content.js",
        "rename.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
